project_id = "replace-with-your-project-id"
region     = "us-central1"

application_name = "blueprint"

# Use immutable image digests or reviewed tags in real deployments.
api_image    = "us-docker.pkg.dev/PROJECT/containers/api:dev"
worker_image = "us-docker.pkg.dev/PROJECT/containers/worker:dev"
batch_image  = "us-docker.pkg.dev/PROJECT/containers/batch:dev"

# Phase 1: keep false while the network/cache/identities/secret metadata are
# created and the required Secret Manager versions are populated externally.
# After applying true once in this state, do not change this back to false:
# an activation lock intentionally rejects that plan before workload deletion.
enable_workloads = false

subnet_ip_cidr_range        = "10.40.0.0/24"
private_service_access_cidr = "10.50.0.0/16"

scheduler_schedule  = "0 2 * * *"
scheduler_time_zone = "America/Sao_Paulo"

# Optional existing notification channels. Channel resources and destinations
# are intentionally managed outside this environment root.
observability_notification_channels = []

# Development keeps the same signals as production with more tolerant defaults.
observability_thresholds = {
  cloud_run_server_error_ratio      = 0.10
  pubsub_oldest_unacked_age_seconds = 600
  redis_memory_usage_ratio          = 0.90
  redis_system_memory_usage_ratio   = 0.90
}

labels = {
  owner = "platform"
}
