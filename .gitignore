# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Terraform plans
*.tfplan
*.plan

# Crash logs
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.auto.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment and credentials
.env
.env.*
!.env.example
service-account*.json
credentials*.json

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
